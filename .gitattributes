# Auto detect text files and normalize line endings to LF in the repository
* text=auto eol=lf

# Explicit text types
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows batch/powershell scripts keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary types - never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.mp3 binary
*.wav binary
*.flac binary
